# Filled in by scripts/barsconf.sh (tokens below in at-signs): per-state bar mode, status command and font.
# Two bars that never change owner: Win+i swaps their status_command (i3bar restarts it on reload).
# The tray stays on bar-main in every state: moving it between two i3bar processes loses icons (the old
# i3bar keeps its event mask on icon windows that apps reuse; Qt apps can miss the handoff).
bar {
  id bar-main
  output DP-0
  position bottom
  hidden_state hide
  mode @MODE@
  @FONT@
  status_command @MAIN_CMD@
  tray_output DP-0
}

# DP-2 (2560): in the rs state compact.toml, generated from config.toml (no disk, ccusage, IP)
bar {
  id bar-small
  output DP-2
  position bottom
  hidden_state hide
  mode @MODE@
  @FONT@
  status_command @SMALL_CMD@
  tray_output none
}
