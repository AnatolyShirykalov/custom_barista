# Filled in by install.sh (tokens below in at-signs): binary, generated i3status-rs configs dir, repo checkout, modifier.
bar {
  id bar-barista
  hidden_state hide
  mode dock
  status_command @BIN@
}

bar {
  id bar-rs
  output DP-0
  position bottom
  hidden_state hide
  mode invisible
  font pango:PragmataPro Mono, Symbols Nerd Font Mono 18
  status_command i3status-rs @CONFDIR@/config.toml
  tray_output none
}

# DP-2 (2560): compact.toml is generated from config.toml (no disk, ccusage, IP)
bar {
  id bar-rs-small
  output DP-2
  position bottom
  hidden_state hide
  mode invisible
  font pango:PragmataPro Mono, Symbols Nerd Font Mono 18
  status_command i3status-rs @CONFDIR@/compact.toml
  tray_output none
}

bindsym @MOD@+i exec --no-startup-id @REPO@/i3status-rust/scripts/barcycle.sh
