# Filled in by scripts/barsconf.sh (tokens below in at-signs): binary, generated i3status-rs configs dir,
# per-state bar mode and tray output. The visible bar(s) dock and hold the tray (one bar per output can).
bar {
  id bar-barista
  hidden_state hide
  mode @BARISTA_MODE@
  status_command @BIN@
  tray_output @BARISTA_TRAY@
}

bar {
  id bar-rs
  output DP-0
  position bottom
  hidden_state hide
  mode @RS_MODE@
  font pango:PragmataPro Mono, Symbols Nerd Font Mono 18
  status_command i3status-rs @CONFDIR@/config.toml
  tray_output @RS_TRAY@
}

# DP-2 (2560): compact.toml is generated from config.toml (no disk, ccusage, IP)
bar {
  id bar-rs-small
  output DP-2
  position bottom
  hidden_state hide
  mode @RS_MODE@
  font pango:PragmataPro Mono, Symbols Nerd Font Mono 18
  status_command i3status-rs @CONFDIR@/compact.toml
  tray_output none
}
